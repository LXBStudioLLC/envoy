<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The notification-area (!) tray icon + balloon toasts are System.Windows.Forms
         primitives #92 leans on; WPF has no first-class NotifyIcon support. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Envoy</AssemblyName>
    <RootNamespace>Envoy.UI</RootNamespace>
    <!-- Embeds the ghost icon as the exe's Win32 icon; WPF uses it for the window
         title bar and taskbar too, and Start-menu/desktop shortcuts inherit it. -->
    <ApplicationIcon>Envoy.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Envoy.Core\Envoy.Core.csproj" />
    <ProjectReference Include="..\Envoy.Assets\Envoy.Assets.csproj" />
    <ProjectReference Include="..\Envoy.Templates\Envoy.Templates.csproj" />
    <ProjectReference Include="..\Envoy.GhostDetection\Envoy.GhostDetection.csproj" />
    <ProjectReference Include="..\Envoy.Discovery\Envoy.Discovery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\**\*.ttf" />
  </ItemGroup>

  <!-- #92 leans on WinForms' NotifyIcon for the tray, but the SDK's implicit
       usings would then shadow WPF names (UserControl, Brush, Image…) in every
       view. TrayPresence.cs carries its own explicit usings instead. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>